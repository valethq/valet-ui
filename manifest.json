{
  "schema": 1,
  "id": "valet-ui",
  "name": "Web UI",
  "version": "0.1.0",
  "description": "Minimal web chat UI served on its own port (default 127.0.0.1:7418).",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "configSchema": {
    "type": "object",
    "properties": {
      "host": {
        "type": "string"
      },
      "port": {
        "type": "integer"
      },
      "coreUrl": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
