{
  "schema": 1,
  "id": "valet-ui",
  "name": "Web UI",
  "version": "0.1.0",
  "description": "Web interface for valet (default 127.0.0.1:7418).",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "configSchema": {
    "type": "object",
    "properties": {
      "host": {
        "type": "string",
        "title": "Host"
      },
      "port": {
        "type": "integer",
        "title": "Port"
      },
      "coreUrl": {
        "type": "string",
        "title": "Server URL"
      },
      "chunkMessages": {
        "type": "integer",
        "title": "Messages per page",
        "minimum": 5,
        "maximum": 100,
        "description": "Messages loaded per page (Experimental)."
      },
      "partChars": {
        "type": "integer",
        "title": "Max characters per chunk",
        "minimum": 500,
        "maximum": 200000,
        "description": "Max characters sent per message part before streaming in chunks."
      }
    },
    "additionalProperties": false
  }
}
