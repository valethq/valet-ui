{
  "schema": 1,
  "id": "valet-ui",
  "name": "Web UI",
  "version": "0.1.0",
  "description": "Web interface for valet (default 127.0.0.1:7418).",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "acl": {
    "permissions": {
      "settings.read": { "summary": "Read plugin settings pages, options and views", "resource": "plugin" },
      "settings.write": {
        "summary": "Run plugin settings actions and save runtime subsections",
        "resource": "plugin",
        "requireVerifiedLogin": true
      }
    }
  },
  "settings": {
    "sections": {
      "system": {
        "subsections": [
          {
            "id": "general",
            "label": "General",
            "items": [
              {
                "id": "host",
                "label": "Host",
                "input": {
                  "type": "string"
                }
              },
              {
                "id": "port",
                "label": "Port",
                "input": {
                  "type": "int"
                }
              },
              {
                "id": "coreUrl",
                "label": "Server URL",
                "input": {
                  "type": "string"
                }
              },
              {
                "id": "chunkMessages",
                "label": "Messages per page",
                "summary": "Messages loaded per page (Experimental).",
                "input": {
                  "type": "int",
                  "min": 5,
                  "max": 100
                }
              },
              {
                "id": "partChars",
                "label": "Max characters per chunk",
                "summary": "Max characters sent per message part before streaming in chunks.",
                "input": {
                  "type": "int",
                  "min": 500,
                  "max": 200000
                }
              }
            ]
          }
        ]
      }
    }
  }
}
